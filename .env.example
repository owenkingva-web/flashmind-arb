# ═══════════════════════════════════════════════════════════════
# T3-3 Vulnerability Hunter — Environment Config
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Wallet (REQUIRED) ──────────────────────────────────────────
WALLET_PRIVATE_KEY=0x_your_private_key_here

# ── Etherscan V2 API (REQUIRED — one key for all chains) ───────
ETHERSCAN_API_KEY=your_key
ARBISCAN_API_KEY=your_key

# ── LLM Provider (pick one, or both for fallback) ───────────────
# Option A: Google Gemini (FREE, works on Railway US)
#   Get key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Option B: Groq (FREE, works globally, Llama 3.3 70B)
#   Get key at https://console.groq.com/keys
GROQ_API_KEY=

# ── Email Alerts (Gmail) ────────────────────────────────────────
ALERT_EMAIL=your@gmail.com
ALERT_EMAIL_PASSWORD=your_16char_app_password
ALERT_EMAIL_TO=your@gmail.com

# ── Private RPC (Alchemy) ──────────────────────────────────────
# Get free at https://alchemy.com (300M CU/month)
RPC_ARBITRUM_PRIVATE=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
